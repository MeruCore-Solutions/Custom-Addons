<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ob_ai_kpi_snapshot_list" model="ir.ui.view">
        <field name="name">ob.ai.kpi.snapshot.list</field>
        <field name="model">ob.ai.kpi.snapshot</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="create_date"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="intent_type"/>
                <field name="target_model"/>
                <field name="state"/>
                <field name="generated_with_ai"/>
                <field name="export_pdf_attachment_id" optional="hide"/>
                <field name="export_image_attachment_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ob_ai_kpi_snapshot_form" model="ir.ui.view">
        <field name="name">ob.ai.kpi.snapshot.form</field>
        <field name="model">ob.ai.kpi.snapshot</field>
        <field name="arch" type="xml">
            <form string="AI KPI Snapshot">
                <header>
                    <button name="action_generate_pdf_dashboard" type="object" string="Generate PDF" class="btn-primary"/>
                    <button name="action_generate_image_dashboard" type="object" string="Generate Image"/>
                    <button name="action_download_pdf_dashboard" type="object" string="Download PDF" invisible="not export_pdf_attachment_id"/>
                    <button name="action_download_image_dashboard" type="object" string="Download Image" invisible="not export_image_attachment_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="source_conversation_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="intent_type"/>
                            <field name="target_model"/>
                            <field name="state"/>
                            <field name="generated_with_ai"/>
                            <field name="export_pdf_attachment_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                            <field name="export_image_attachment_id" readonly="1" options="{'no_create': True, 'no_open': False}"/>
                        </group>
                    </group>
                    <group>
                        <field name="summary_text" nolabel="1"/>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list default_order="sequence asc">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="metric_code"/>
                            <field name="model_name"/>
                            <field name="value_float"/>
                            <field name="value_char"/>
                            <field name="domain_summary"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ob_ai_kpi_snapshot" model="ir.actions.act_window">
        <field name="name">KPI Snapshots</field>
        <field name="res_model">ob.ai.kpi.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
