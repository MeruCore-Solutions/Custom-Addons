<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ob_ai_audit_log_list" model="ir.ui.view">
        <field name="name">ob.ai.audit.log.list</field>
        <field name="model">ob.ai.audit.log</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="create_date"/>
                <field name="conversation_id"/>
                <field name="user_id"/>
                <field name="status"/>
                <field name="intent_code"/>
                <field name="action_performed"/>
                <field name="provider_id"/>
                <field name="model_id"/>
                <field name="schema_version_id"/>
                <field name="request_token_id"/>
                <field name="investigation_trace_id"/>
                <field name="memory_state_id"/>
                <field name="http_status"/>
                <field name="latency_ms"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
            </list>
        </field>
    </record>

    <record id="view_ob_ai_audit_log_form" model="ir.ui.view">
        <field name="name">ob.ai.audit.log.form</field>
        <field name="model">ob.ai.audit.log</field>
        <field name="arch" type="xml">
            <form string="AI Audit Log">
                <sheet>
                    <group>
                        <group>
                            <field name="conversation_id"/>
                            <field name="message_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="request_kind"/>
                            <field name="status"/>
                            <field name="intent_code"/>
                            <field name="action_requested"/>
                            <field name="action_performed"/>
                            <field name="provider_id"/>
                            <field name="model_id"/>
                            <field name="schema_version_id"/>
                            <field name="request_token_id"/>
                            <field name="investigation_trace_id"/>
                            <field name="memory_state_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="provider_response_id"/>
                            <field name="request_id"/>
                            <field name="idempotency_key"/>
                            <field name="http_status"/>
                            <field name="latency_ms"/>
                        </group>
                        <group>
                            <field name="prompt_char_count"/>
                            <field name="response_char_count"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Metadata">
                            <group>
                                <field name="accessed_models"/>
                                <field name="accessed_record_ids"/>
                                <field name="accessed_fields"/>
                                <field name="blocked_fields"/>
                                <field name="hidden_record_count"/>
                                <field name="related_model"/>
                                <field name="related_record_refs"/>
                                <field name="confidence_score"/>
                                <field name="human_review_status"/>
                                <field name="warning_message"/>
                                <field name="error_message"/>
                            </group>
                        </page>
                        <page string="Payloads">
                            <group>
                                <field name="context_payload"/>
                                <field name="request_payload"/>
                                <field name="response_payload"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ob_ai_audit_log" model="ir.actions.act_window">
        <field name="name">AI Audit Logs</field>
        <field name="res_model">ob.ai.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
