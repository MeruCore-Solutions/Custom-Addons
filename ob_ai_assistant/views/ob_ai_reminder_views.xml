<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ob_ai_reminder_list" model="ir.ui.view">
        <field name="name">ob.ai.reminder.list</field>
        <field name="model">ob.ai.reminder</field>
        <field name="arch" type="xml">
            <list default_order="due_datetime asc">
                <field name="name"/>
                <field name="requesting_user_id"/>
                <field name="assigned_user_id"/>
                <field name="related_record_ref"/>
                <field name="due_datetime"/>
                <field name="status"/>
                <field name="notification_sent"/>
            </list>
        </field>
    </record>

    <record id="view_ob_ai_reminder_form" model="ir.ui.view">
        <field name="name">ob.ai.reminder.form</field>
        <field name="model">ob.ai.reminder</field>
        <field name="arch" type="xml">
            <form string="AI Reminder">
                <header>
                    <button name="action_mark_done" type="object" string="Mark Done" invisible="status == 'done'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status in ('done', 'cancelled')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,due,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="requesting_user_id" readonly="1"/>
                            <field name="assigned_user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="related_record_ref"/>
                            <field name="due_datetime"/>
                            <field name="notification_sent"/>
                            <field name="activity_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reminder_text" nolabel="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="source_conversation_id" readonly="1"/>
                            <field name="source_message_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="created_by_ai" readonly="1"/>
                            <field name="idempotency_key" readonly="1"/>
                            <field name="access_scope"/>
                        </group>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ob_ai_reminder" model="ir.actions.act_window">
        <field name="name">AI Reminders</field>
        <field name="res_model">ob.ai.reminder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
