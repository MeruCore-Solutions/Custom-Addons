<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ob_ai_prompt_template_list" model="ir.ui.view">
        <field name="name">ob.ai.prompt.template.list</field>
        <field name="model">ob.ai.prompt.template</field>
        <field name="arch" type="xml">
            <list default_order="code,version desc">
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="intent_type"/>
                <field name="allowed_model_id"/>
                <field name="requires_approval"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ob_ai_prompt_template_form" model="ir.ui.view">
        <field name="name">ob.ai.prompt.template.form</field>
        <field name="model">ob.ai.prompt.template</field>
        <field name="arch" type="xml">
            <form string="AI Prompt Template">
                <header>
                    <button name="action_duplicate_new_version" type="object" string="New Version"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="version"/>
                            <field name="intent_type"/>
                        </group>
                        <group>
                            <field name="allowed_model_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="read_only"/>
                        </group>
                    </group>
                    <group>
                        <field name="keyword_pattern" placeholder="dashboard,kpi,how many"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Prompt">
                            <group>
                                <field name="prompt_text" nolabel="1"/>
                                <field name="system_instruction" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Actions">
                            <group>
                                <group>
                                    <field name="allow_document_context"/>
                                    <field name="allow_dashboard_generation"/>
                                    <field name="allow_validation"/>
                                </group>
                                <group>
                                    <field name="allow_reminder_creation"/>
                                    <field name="allow_activity_creation"/>
                                    <field name="allow_chatter_post"/>
                                </group>
                            </group>
                        </page>
                        <page string="Governance">
                            <group>
                                <group>
                                    <field name="requires_approval"/>
                                    <field name="store_input"/>
                                    <field name="store_output"/>
                                    <field name="retention_days"/>
                                </group>
                                <group>
                                    <field name="run_in_cron"/>
                                    <field name="cron_interval_number"/>
                                    <field name="cron_interval_type"/>
                                </group>
                            </group>
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ob_ai_prompt_template" model="ir.actions.act_window">
        <field name="name">Prompt Templates</field>
        <field name="res_model">ob.ai.prompt.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
