<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ob_ai_validation_rule_list" model="ir.ui.view">
        <field name="name">ob.ai.validation.rule.list</field>
        <field name="model">ob.ai.validation.rule</field>
        <field name="arch" type="xml">
            <list default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target_model_id"/>
                <field name="rule_type"/>
                <field name="severity"/>
                <field name="requires_approval"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ob_ai_validation_rule_form" model="ir.ui.view">
        <field name="name">ob.ai.validation.rule.form</field>
        <field name="model">ob.ai.validation.rule</field>
        <field name="arch" type="xml">
            <form string="AI Validation Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="target_model_id"/>
                            <field name="rule_type"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="requires_approval"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields">
                            <group>
                                <field name="required_field_ids" widget="many2many_tags"/>
                                <field name="date_field_id"/>
                                <field name="numeric_field_id"/>
                                <field name="minimum_numeric_value"/>
                                <field name="state_field_id"/>
                                <field name="allowed_state_values"/>
                            </group>
                        </page>
                        <page string="Guidance">
                            <field name="description" nolabel="1"/>
                            <field name="ai_instruction" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ob_ai_validation_result_list" model="ir.ui.view">
        <field name="name">ob.ai.validation.result.list</field>
        <field name="model">ob.ai.validation.result</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="create_date"/>
                <field name="related_record_ref"/>
                <field name="rule_id"/>
                <field name="validation_status"/>
                <field name="review_status"/>
                <field name="reviewer_id"/>
            </list>
        </field>
    </record>

    <record id="view_ob_ai_validation_result_form" model="ir.ui.view">
        <field name="name">ob.ai.validation.result.form</field>
        <field name="model">ob.ai.validation.result</field>
        <field name="arch" type="xml">
            <form string="AI Validation Result">
                <sheet>
                    <group>
                        <group>
                            <field name="related_record_ref"/>
                            <field name="rule_id"/>
                            <field name="validation_status"/>
                            <field name="review_status"/>
                        </group>
                        <group>
                            <field name="source_conversation_id" readonly="1"/>
                            <field name="source_approval_id" readonly="1"/>
                            <field name="reviewer_id"/>
                            <field name="confidence_score"/>
                        </group>
                    </group>
                    <group>
                        <field name="ai_explanation" nolabel="1"/>
                        <field name="suggested_action" nolabel="1"/>
                        <field name="final_decision" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Metrics">
                            <field name="metrics_payload" nolabel="1"/>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ob_ai_validation_rule" model="ir.actions.act_window">
        <field name="name">Validation Rules</field>
        <field name="res_model">ob.ai.validation.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_ob_ai_validation_result" model="ir.actions.act_window">
        <field name="name">Validation Results</field>
        <field name="res_model">ob.ai.validation.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
