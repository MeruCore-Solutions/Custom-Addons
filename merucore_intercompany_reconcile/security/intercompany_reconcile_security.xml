<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="m_rule_intercompany_match_visibility_user" model="ir.rule">
        <field name="name">Intercompany Matches: dual-company visibility</field>
        <field name="model_id" ref="model_merucore_intercompany_match"/>
        <field name="groups" eval="[(4, ref('merucore_intercompany_base.m_group_intercompany_user'))]"/>
        <field name="domain_force">[('m_source_company_id', 'in', company_ids), ('m_destination_company_id', 'in', company_ids)]</field>
    </record>

