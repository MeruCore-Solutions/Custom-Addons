<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="m_seq_intercompany_match" model="ir.sequence">
        <field name="name">MeruCore Intercompany Match</field>
        <field name="code">merucore.intercompany.match</field>
        <field name="prefix">ICM%(y)s</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="m_seq_intercompany_settlement" model="ir.sequence">
        <field name="name">MeruCore Intercompany Settlement</field>
        <field name="code">merucore.intercompany.settlement</field>
        <field name="prefix">ICS%(y)s</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
