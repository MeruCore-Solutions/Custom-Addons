<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="m_action_intercompany_transactions" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">merucore.intercompany.transaction</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="m_view_intercompany_transaction_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first intercompany transaction control record.
            </p>
            <p>
                Track company-pair activity, audit retries, and monitor transaction health from a central place.
            </p>
        </field>
    </record>

    <record id="m_action_intercompany_issues" model="ir.actions.act_window">
        <field name="name">Issues</field>
        <field name="res_model">merucore.intercompany.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="m_view_intercompany_transaction_search"/>
        <field name="domain">[('m_has_open_issue', '=', True)]</field>
        <field name="context">{'search_default_m_filter_open_issue': 1}</field>
    </record>

    <record id="m_action_intercompany_events" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">merucore.intercompany.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="m_view_intercompany_event_search"/>
        <field name="context">{'create': False}</field>
    </record>

    <record id="m_action_intercompany_rules" model="ir.actions.act_window">
        <field name="name">Company Pair Rules</field>
        <field name="res_model">merucore.intercompany.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="m_view_intercompany_rule_search"/>
        <field name="context">{}</field>
    </record>

    <menuitem id="m_menu_intercompany_root"
              name="Intercompany"
              action="m_action_intercompany_transactions"
              sequence="20"
              groups="merucore_intercompany_base.m_group_intercompany_user"
              web_icon="merucore_intercompany_base,static/description/icon.png"/>

    <menuitem id="m_menu_intercompany_control_center"
              name="Control Center"
              parent="m_menu_intercompany_root"
              sequence="10"
              groups="merucore_intercompany_base.m_group_intercompany_user"/>

    <menuitem id="m_menu_intercompany_transactions"
              name="Transactions"
              parent="m_menu_intercompany_control_center"
              action="m_action_intercompany_transactions"
              sequence="10"
              groups="merucore_intercompany_base.m_group_intercompany_user"/>

    <menuitem id="m_menu_intercompany_issues"
              name="Issues"
              parent="m_menu_intercompany_control_center"
              action="m_action_intercompany_issues"
              sequence="20"
              groups="merucore_intercompany_base.m_group_intercompany_user"/>

    <menuitem id="m_menu_intercompany_events"
              name="Events"
              parent="m_menu_intercompany_control_center"
              action="m_action_intercompany_events"
              sequence="30"
              groups="merucore_intercompany_base.m_group_intercompany_user"/>

    <menuitem id="m_menu_intercompany_configuration"
              name="Configuration"
              parent="m_menu_intercompany_root"
              sequence="90"
              groups="merucore_intercompany_base.m_group_intercompany_manager"/>

    <menuitem id="m_menu_intercompany_rules"
              name="Company Pair Rules"
              parent="m_menu_intercompany_configuration"
              action="m_action_intercompany_rules"
              sequence="10"
              groups="merucore_intercompany_base.m_group_intercompany_manager"/>
</odoo>
