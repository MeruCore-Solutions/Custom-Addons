<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="m_view_intercompany_transaction_list" model="ir.ui.view">
        <field name="name">merucore.intercompany.transaction.list</field>
        <field name="model">merucore.intercompany.transaction</field>
        <field name="arch" type="xml">
            <list decoration-muted="m_state == 'cancelled'"
                  decoration-success="m_state == 'done'"
                  decoration-warning="m_health_state in ('warning', 'retrying')"
                  decoration-danger="m_health_state == 'failed'">
                <field name="m_name"/>
                <field name="m_source_company_id" groups="base.group_multi_company"/>
                <field name="m_destination_company_id" groups="base.group_multi_company"/>
                <field name="m_transaction_type"/>
                <field name="m_state"/>
                <field name="m_health_state"/>
                <field name="m_responsible_user_id" optional="hide"/>
                <field name="m_last_sync_at" optional="hide"/>
                <field name="m_retry_count"/>
                <field name="m_next_retry_at" optional="show"/>
                <field name="m_has_open_issue" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="m_view_intercompany_transaction_search" model="ir.ui.view">
        <field name="name">merucore.intercompany.transaction.search</field>
        <field name="model">merucore.intercompany.transaction</field>
        <field name="arch" type="xml">
            <search string="Transactions">
                <field name="m_name"/>
                <field name="m_reference"/>
                <field name="m_source_company_id"/>
                <field name="m_destination_company_id"/>
                <field name="m_transaction_type"/>
                <field name="m_responsible_user_id"/>
                <filter name="m_filter_my_transactions" string="My Transactions" domain="[('m_responsible_user_id', '=', uid)]"/>
                <filter name="m_filter_healthy" string="Healthy" domain="[('m_health_state', '=', 'healthy')]"/>
                <filter name="m_filter_warning" string="Warnings" domain="[('m_health_state', '=', 'warning')]"/>
                <filter name="m_filter_failed" string="Failed" domain="[('m_health_state', '=', 'failed')]"/>
                <filter name="m_filter_retrying" string="Retrying" domain="[('m_health_state', '=', 'retrying')]"/>
                <filter name="m_filter_open_issue" string="Open Issues" domain="[('m_has_open_issue', '=', True)]"/>
                <filter name="m_filter_done" string="Done" domain="[('m_state', '=', 'done')]"/>
                <filter name="m_filter_cancelled" string="Cancelled" domain="[('m_state', '=', 'cancelled')]"/>
                <group>
                    <filter name="m_group_source_company" string="Source Company" context="{'group_by': 'm_source_company_id'}"/>
                    <filter name="m_group_destination_company" string="Destination Company" context="{'group_by': 'm_destination_company_id'}"/>
                    <filter name="m_group_transaction_type" string="Transaction Type" context="{'group_by': 'm_transaction_type'}"/>
                    <filter name="m_group_state" string="State" context="{'group_by': 'm_state'}"/>
                    <filter name="m_group_health_state" string="Health" context="{'group_by': 'm_health_state'}"/>
                    <filter name="m_group_responsible_user" string="Responsible User" context="{'group_by': 'm_responsible_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="m_view_intercompany_transaction_form" model="ir.ui.view">
        <field name="name">merucore.intercompany.transaction.form</field>
        <field name="model">merucore.intercompany.transaction</field>
        <field name="arch" type="xml">
            <form string="Intercompany Transaction">
                <field name="m_source_document_accessible" invisible="1"/>
                <field name="m_destination_document_accessible" invisible="1"/>
                <header>
                    <button name="m_action_start"
                            string="Start"
                            type="object"
                            class="oe_highlight"
                            invisible="m_state in ('in_progress', 'done', 'cancelled')"/>
                    <button name="m_action_mark_done"
                            string="Mark Done"
                            type="object"
                            class="oe_highlight"
                            invisible="m_state != 'in_progress'"/>
                    <button name="m_action_open_retry_wizard"
                            string="Retry"
                            type="object"
                            invisible="m_state in ('done', 'cancelled') or m_health_state not in ('warning', 'failed')"/>
                    <button name="m_action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="m_state in ('done', 'cancelled')"/>
                    <field name="m_state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="m_action_open_events" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="m_event_count" widget="statinfo" string="Events"/>
                        </button>
                        <button name="m_action_open_error_events" type="object" class="oe_stat_button" icon="fa-bug">
                            <field name="m_error_event_count" widget="statinfo" string="Errors"/>
                        </button>
                        <button name="m_action_open_warning_events" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="m_warning_event_count" widget="statinfo" string="Warnings"/>
                        </button>
                        <button name="m_action_open_source_document"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-arrow-circle-left"
                                invisible="not m_source_document_accessible">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Source</span>
                                <span class="o_stat_text">Document</span>
                            </div>
                        </button>
                        <button name="m_action_open_destination_document"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-arrow-circle-right"
                                invisible="not m_destination_document_accessible">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Destination</span>
                                <span class="o_stat_text">Document</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="m_name"/>
                            <field name="m_rule_id" options="{'no_create_edit': True}"/>
                            <field name="m_transaction_type"/>
                            <field name="m_reference"/>
                            <field name="m_idempotency_key" groups="merucore_intercompany_base.m_group_intercompany_manager"/>
                            <field name="m_responsible_user_id" options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="m_health_state"/>
                            <field name="m_retry_count"/>
                            <field name="m_next_retry_at"/>
                            <field name="m_last_sync_at"/>
                            <field name="m_last_health_check_at"/>
                            <field name="m_last_error_message" readonly="1"/>
                        </group>
                    </group>
                    <group string="Company Pair">
                        <group>
                            <field name="m_source_company_id" groups="base.group_multi_company" options="{'no_create_edit': True}"/>
                            <field name="m_source_model"/>
                            <field name="m_source_res_id"/>
                            <field name="m_source_document_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="m_destination_company_id" groups="base.group_multi_company" options="{'no_create_edit': True}"/>
                            <field name="m_destination_model"/>
                            <field name="m_destination_res_id"/>
                            <field name="m_destination_document_name" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="m_note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="m_view_intercompany_transaction_graph" model="ir.ui.view">
        <field name="name">merucore.intercompany.transaction.graph</field>
        <field name="model">merucore.intercompany.transaction</field>
        <field name="arch" type="xml">
            <graph string="Transaction Health" type="bar">
                <field name="m_source_company_id"/>
                <field name="m_health_state"/>
            </graph>
        </field>
    </record>

    <record id="m_view_intercompany_transaction_pivot" model="ir.ui.view">
        <field name="name">merucore.intercompany.transaction.pivot</field>
        <field name="model">merucore.intercompany.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Transaction Analysis">
                <field name="m_source_company_id" type="row"/>
                <field name="m_destination_company_id" type="col"/>
                <field name="m_health_state" type="col"/>
            </pivot>
        </field>
    </record>
</odoo>
