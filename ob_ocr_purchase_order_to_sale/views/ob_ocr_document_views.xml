<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ob_ocr_document_search_customer_po" model="ir.ui.view">
        <field name="name">ob.ocr.document.search.customer.po</field>
        <field name="model">ob.ocr.document</field>
        <field name="inherit_id" ref="ob_ocr_base.view_ob_ocr_document_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Customer POs" name="customer_purchase_order" domain="[('document_type', '=', 'customer_purchase_order')]"/>
            </xpath>
        </field>
    </record>
</odoo>
