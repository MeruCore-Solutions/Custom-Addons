<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_ob_ocr_po_to_sale" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ob.ocr.po.to.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_open_ocr_documents" class="oe_stat_button" icon="fa-file-text-o" invisible="ocr_document_count == 0">
                    <field name="ocr_document_count" widget="statinfo" string="OCR Documents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
