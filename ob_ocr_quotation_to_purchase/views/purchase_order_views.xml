<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_ob_ocr_quote" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.ob.ocr.quote</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_open_ocr_documents" class="oe_stat_button" icon="fa-file-text-o" invisible="ocr_document_count == 0">
                    <field name="ocr_document_count" widget="statinfo" string="OCR Documents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
