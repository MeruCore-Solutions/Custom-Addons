<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ob_ocr_document_search_supplier_quote" model="ir.ui.view">
        <field name="name">ob.ocr.document.search.supplier.quote</field>
        <field name="model">ob.ocr.document</field>
        <field name="inherit_id" ref="ob_ocr_base.view_ob_ocr_document_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Supplier Quotes" name="supplier_quotation" domain="[('document_type', '=', 'supplier_quotation')]"/>
            </xpath>
        </field>
    </record>
</odoo>
