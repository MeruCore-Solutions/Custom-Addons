<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ob_ocr_vendor_bill" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ob.ocr.vendor.bill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_open_ocr_documents" class="oe_stat_button" icon="fa-file-text-o" invisible="ocr_document_count == 0">
                    <field name="ocr_document_count" widget="statinfo" string="OCR Documents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
