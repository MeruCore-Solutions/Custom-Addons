<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="m_view_account_move_form_intercompany" model="ir.ui.view">
        <field name="name">account.move.form.intercompany</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="m_action_sync_intercompany_counterpart"
                        string="Sync Counterpart"
                        type="object"
                        class="btn-secondary"
                        invisible="not m_intercompany_rule_id or state == 'cancel'"
                        groups="merucore_intercompany_base.m_group_intercompany_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="m_action_open_intercompany_transaction"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-random"
                        invisible="not m_intercompany_transaction_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Intercompany</span>
                        <span class="o_stat_text">Transaction</span>
                    </div>
                </button>
                <button name="m_action_open_intercompany_counterparts"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-files-o"
                        invisible="not m_intercompany_counterpart_count">
                    <field name="m_intercompany_counterpart_count" widget="statinfo" string="Counterparts"/>
                </button>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="after">
                <group string="Intercompany" groups="merucore_intercompany_base.m_group_intercompany_user">
                    <group>
                        <field name="m_intercompany_rule_id" readonly="1"/>
                        <field name="m_intercompany_role" readonly="1"/>
                        <field name="m_intercompany_sync_state" readonly="1"/>
                        <field name="m_intercompany_matching_state" readonly="1"/>
                    </group>
                    <group>
                        <field name="m_intercompany_transaction_id" readonly="1"/>
                        <field name="m_intercompany_document_key" readonly="1" groups="merucore_intercompany_base.m_group_intercompany_manager"/>
                        <field name="m_intercompany_last_sync_at" readonly="1"/>
                        <field name="m_intercompany_last_error" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="m_view_account_move_tree_intercompany" model="ir.ui.view">
        <field name="name">account.move.tree.intercompany</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="m_intercompany_sync_state" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
