    <record id="m_rule_intercompany_account_mapping_visibility_user" model="ir.rule">
        <field name="name">Intercompany Account Mappings: dual-company visibility</field>
        <field name="model_id" ref="model_merucore_intercompany_account_mapping"/>
        <field name="groups" eval="[(4, ref('merucore_intercompany_base.m_group_intercompany_user'))]"/>
        <field name="domain_force">[('m_rule_id.m_source_company_id', 'in', company_ids), ('m_rule_id.m_destination_company_id', 'in', company_ids)]</field>
