<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ocr" model="ir.module.category">
        <field name="name">OCR</field>
        <field name="description">OCR framework access rights</field>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_ocr" model="res.groups.privilege">
        <field name="name">OCR</field>
        <field name="description">OCR framework roles</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="ob_ocr_base.module_category_ocr"/>
    </record>

    <record id="group_ocr_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="ob_ocr_base.res_groups_privilege_ocr"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ocr_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="ob_ocr_base.res_groups_privilege_ocr"/>
        <field name="implied_ids" eval="[Command.link(ref('ob_ocr_base.group_ocr_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rule_ob_ocr_document_company" model="ir.rule">
        <field name="name">OCR Documents by Company</field>
        <field name="model_id" ref="model_ob_ocr_document"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>

    <record id="rule_ob_ocr_document_line_company" model="ir.rule">
        <field name="name">OCR Document Lines by Company</field>
        <field name="model_id" ref="model_ob_ocr_document_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>

    <record id="rule_ob_ocr_provider_company" model="ir.rule">
        <field name="name">OCR Providers by Company</field>
        <field name="model_id" ref="model_ob_ocr_provider"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>

    <record id="rule_ob_ocr_document_type_company" model="ir.rule">
        <field name="name">OCR Document Types by Company</field>
        <field name="model_id" ref="model_ob_ocr_document_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>

    <record id="rule_ob_ocr_mapping_company" model="ir.rule">
        <field name="name">OCR Mappings by Company</field>
        <field name="model_id" ref="model_ob_ocr_mapping"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>

    <record id="rule_ob_ocr_mapping_field_company" model="ir.rule">
        <field name="name">OCR Mapping Fields by Company</field>
        <field name="model_id" ref="model_ob_ocr_mapping_field"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>

    <record id="rule_ob_ocr_extraction_rule_company" model="ir.rule">
        <field name="name">OCR Extraction Rules by Company</field>
        <field name="model_id" ref="model_ob_ocr_extraction_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>

    <record id="rule_ob_ocr_log_company" model="ir.rule">
        <field name="name">OCR Logs by Company</field>
        <field name="model_id" ref="model_ob_ocr_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ob_ocr_base.group_ocr_user'))]"/>
    </record>
</odoo>
